# Скопируйте этот файл в .env и укажите свои значения:
#   cp .env.example .env
#
# Файл .env читает и docker compose (при поднятии базы),
# и вы сами — когда экспортируете переменные перед запуском приложения.
# .env в git не попадает.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_db
DB_USER=db_user
DB_PASSWORD=замените_на_свой_пароль
